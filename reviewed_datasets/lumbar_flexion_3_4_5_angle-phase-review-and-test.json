    "reasoning_by_file": {
      "flexion_4": [
        "Neutral to approaching: relative_pitch starts a sustained rise above its initial neutral band at about 3.7 s; the guided cue near 3.0 s is early.",
        "Approaching to holding: relative_pitch reaches about 47?50 degrees and flattens around 5.3 s; guided cue near 6.0 s is late.",
        "Holding to returning: after a long partial-angle drift, a sustained final decrease toward the initial angle begins near 13.35 s; guided cue near 11.0 s is early. Confidence is limited because roll/pitch drift during the nominal hold and there may be an intermediate reposition.",
        "Returning to neutral: relative_pitch returns near the first neutral band around 14.1 s and then remains stable; guided cue near 14.0 s is close."
      ],
      "flexion_5": [
        "Neutral to approaching: relative_pitch begins a sustained rise around 3.7 s; guided cue near 3.0 s is early.",
        "Approaching to holding: relative_pitch reaches the 48?52 degree plateau around 5.3 s; guided cue near 6.0 s is late.",
        "Holding to returning: relative_pitch begins a sustained decline around 11.65 s; guided cue near 11.0 s is early by about 0.65 s.",
        "Returning to neutral: the angle reaches its final stable band around 13.0 s; guided cue near 14.0 s is late by about 1 s."
      ]
    },
